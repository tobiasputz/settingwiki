# GM editor password. Strongly recommended in production.
ADMIN_PASSWORD=change-this

# Optional. Leave unset for a public player wiki.
# PLAYER_PASSWORD=players-only

# pdflatex, xelatex, or lualatex
LATEX_ENGINE=pdflatex
LATEX_TIMEOUT=60

# Disabled by default for security. Only enable if your own LaTeX source
# genuinely requires shell escape (for example minted).
LATEX_ALLOW_SHELL_ESCAPE=0

# Local development only. Railway should mount its persistent volume here.
DATA_DIR=/data
