# GM editor password. Strongly recommended in production.
ADMIN_PASSWORD=change-this

# Player access is invitation-only by default and needs no shared password.
# Set this only if you deliberately choose the legacy Shared Password mode in Admin → Access.
# PLAYER_PASSWORD=players-only

# auto, pdflatex, xelatex, or lualatex
# auto is recommended: Seeker detects fontspec/Unicode-engine projects.
LATEX_ENGINE=auto
LATEX_TIMEOUT=60

# Disabled by default for security. Only enable if your own LaTeX source
# genuinely requires shell escape (for example minted).
LATEX_ALLOW_SHELL_ESCAPE=0

# Local development only. Railway should mount its persistent volume here.
DATA_DIR=/data

# Resource guardrails. The web app rebuilds the Codex only when source changed.
# PDF compilation is intentionally manual in Studio by default because TeX is the
# heaviest process in the Railway container.
COMPILE_ON_START=0
SEEKER_BUILD_LOG_TAIL_BYTES=4194304

# Optional spoiler-aware AI assistant. Legacy pre-Seeker variable names are still accepted.
# SEEKER_AI_API_KEY=
# SEEKER_AI_MODEL=
# SEEKER_AI_BASE_URL=https://api.openai.com/v1

# Optional canonical public origin for integrations. Railway normally provides
# RAILWAY_PUBLIC_DOMAIN automatically, so this is only needed behind unusual proxies.
# SEEKER_PUBLIC_URL=https://seeker.up.railway.app
